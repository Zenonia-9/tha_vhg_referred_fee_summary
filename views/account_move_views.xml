<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bills list: insert after the standard Pay header button.
         type=object creates the wizard first so summary lines are visible on open. -->
    <record id="view_account_move_referred_summary_button" model="ir.ui.view">
        <field name="name">account.move.referred.summary.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <button name="action_force_register_payment" position="after">
                <button name="action_open_referred_fee_summary"
                        string="Referred Summary"
                        type="object"
                        class="btn-secondary"
                        groups="account.group_account_invoice"/>
            </button>
        </field>
    </record>
</odoo>
