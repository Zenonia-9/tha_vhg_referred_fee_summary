<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_referred_fee" model="ir.module.category">
        <field name="name">Referred Fee Summary</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_referred_fee_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_referred_fee"/>
    </record>

    <record id="group_referred_fee_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_referred_fee"/>
        <field name="implied_ids" eval="[(4, ref('group_referred_fee_user'))]"/>
    </record>
</odoo>

</parameter>