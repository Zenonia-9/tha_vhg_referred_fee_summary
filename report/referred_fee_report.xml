<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_referred_fee" model="report.paperformat">
        <field name="name">Referred Fee Summary</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">14</field>
        <field name="margin_right">14</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_referred_fee_pdf" model="ir.actions.report">
        <field name="name">Referred Fee Summary (PDF)</field>
        <field name="model">tha.referred.fee.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tha_vhg_referred_fee_summary.report_referred_fee_template</field>
        <field name="report_file">tha_vhg_referred_fee_summary.report_referred_fee_template</field>
        <field name="print_report_name">'Referred fees %s' % (object.partner_id.name or '')</field>
        <field name="paperformat_id" ref="paperformat_referred_fee"/>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
